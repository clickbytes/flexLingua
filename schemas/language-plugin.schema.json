{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flexlingua.local/schemas/language-plugin.schema.json",
  "title": "flexLingua language plugin manifest",
  "type": "object",
  "required": ["id", "code", "schemaVersion", "graph", "status", "capabilities", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
    "code": {"type": "string", "pattern": "^[a-z]{2,8}$"},
    "schemaVersion": {"const": "1.0"},
    "graph": {"$ref": "#/$defs/packagePath"},
    "status": {"enum": ["controlled-subset", "limited-demo", "morphology-only"]},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "plugin-capability.schema.json"}
    },
    "provenance": {"$ref": "#/$defs/packagePath"}
  },
  "additionalProperties": false,
  "$defs": {
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$",
      "not": {"pattern": "(^|/)\\.\\.(/|$)"}
    }
  }
}
