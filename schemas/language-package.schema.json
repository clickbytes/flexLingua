{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flexlingua.local/schemas/language-package.schema.json",
  "title": "flexLingua language package manifest",
  "type": "object",
  "required": ["version", "language", "status", "demonstrationLevel", "scope", "tokenizer", "packages", "capabilities", "audits"],
  "properties": {
    "version": {"const": "1.0"},
    "language": {"type": "string", "pattern": "^[a-z]{2,8}$"},
    "status": {"enum": ["controlled-subset", "limited-demo", "morphology-only"]},
    "demonstrationLevel": {"enum": ["controlled", "limited", "structural"]},
    "scope": {"type": "string", "minLength": 1, "maxLength": 512},
    "tokenizer": {"$ref": "#/$defs/textProfile"},
    "packages": {
      "type": "object",
      "required": ["core", "lexicon", "grammar", "morphology", "morphologyLexicon", "morphologyFeatures"],
      "properties": {
        "core": {"$ref": "#/$defs/packagePath"},
        "lexicon": {"$ref": "#/$defs/optionalPackagePath"},
        "grammar": {"$ref": "#/$defs/optionalPackagePath"},
        "morphology": {"$ref": "#/$defs/optionalPackagePath"},
        "morphologyLexicon": {"$ref": "#/$defs/optionalPackagePath"},
        "morphologyFeatures": {"$ref": "#/$defs/optionalPackagePath"}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["parsing", "realization", "morphology", "questions", "frames", "directions"],
      "properties": {
        "parsing": {"type": "boolean"},
        "realization": {"type": "boolean"},
        "morphology": {"type": "boolean"},
        "questions": {"type": "boolean"},
        "frames": {"type": "array", "uniqueItems": true, "maxItems": 128,
          "items": {"type": "string", "pattern": "^(event|state)\\.[a-z][a-z0-9_.]*$"}},
        "directions": {"type": "array", "uniqueItems": true, "maxItems": 32,
          "items": {"type": "string", "pattern": "^[a-z]{2,8}->[a-z]{2,8}$"}}
      },
      "additionalProperties": false
    },
    "audits": {
      "type": "object",
      "required": ["strictLexicon", "morphology"],
      "properties": {
        "strictLexicon": {"$ref": "#/$defs/audit"},
        "morphology": {
          "type": "object", "required": ["enabled", "legacyInflections", "reason"],
          "properties": {
            "enabled": {"type": "boolean"},
            "legacyInflections": {"type": "boolean"},
            "reason": {"type": ["string", "null"], "maxLength": 256}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "packagePath": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_./-]+\\.json$", "not": {"pattern": "(^|/)\\.\\.(/|$)"}},
    "optionalPackagePath": {"anyOf": [{"$ref": "#/$defs/packagePath"}, {"type": "null"}]},
    "textProfile": {
      "type": "object",
      "required": ["version", "locale", "normalization", "caseFold", "segmentation"],
      "properties": {
        "version": {"const": "1.0"},
        "locale": {"type": "string", "minLength": 2, "maxLength": 35},
        "normalization": {"const": "NFC"},
        "caseFold": {"const": "locale-lower"},
        "segmentation": {"const": "unicode-whitespace-v1"}
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object", "required": ["enabled", "reason"],
      "properties": {
        "enabled": {"type": "boolean"},
        "reason": {"type": ["string", "null"], "maxLength": 256}
      },
      "additionalProperties": false
    }
  }
}
