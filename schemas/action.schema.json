{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://clickbytes.github.io/flexLingua/schemas/action.schema.json",
  "title":"FlexLingua declarative local action",
  "type":"object","additionalProperties":false,
  "required":["id","parameters","effects"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9_]*$"},
    "parameters":{"type":"object","maxProperties":16,
      "propertyNames":{"pattern":"^[a-zA-Z][a-zA-Z0-9_]*$"},
      "additionalProperties":{"oneOf":[
        {"type":"object","additionalProperties":false,"required":["type","enum"],
          "properties":{"type":{"const":"string"},"enum":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string"}}}},
        {"type":"object","additionalProperties":false,"required":["type","min","max"],
          "properties":{"type":{"const":"integer"},"min":{"type":"integer"},"max":{"type":"integer"}}},
        {"type":"object","additionalProperties":false,"required":["type"],
          "properties":{"type":{"const":"boolean"}}}
      ]}},
    "effects":{"type":"array","minItems":1,"maxItems":16,
      "items":{"oneOf":[
        {"type":"object","additionalProperties":false,"required":["op","key","from"],
          "properties":{"op":{"const":"set"},"key":{"type":"string"},"from":{"type":"string"}}},
        {"type":"object","additionalProperties":false,"required":["op","key","by"],
          "properties":{"op":{"const":"increment"},"key":{"type":"string"},"by":{"type":"integer"}}}
      ]}}
  }
}
