{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flexlingua.local/schemas/lexeme.schema.json",
  "title": "flexLingua canonical lexeme v1.01",
  "type": "object",
  "required": ["id", "lemma", "senses"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]+)*$" },
    "lemma": { "type": "string", "minLength": 1 },
    "senses": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "required": ["id", "coreRef"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "coreRef": { "$ref": "core-reference.schema.json" },
          "priority": { "type": "integer", "minimum": -100, "maximum": 100 }
        },
        "additionalProperties": false
      }
    }
  },
  "not": { "required": ["concept"] }
}
