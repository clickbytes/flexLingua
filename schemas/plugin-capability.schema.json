{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flexlingua.local/schemas/plugin-capability.schema.json",
  "title": "flexLingua construction-level language capability",
  "type": "object",
  "required": ["operation", "channel", "construction", "status", "evidence"],
  "properties": {
    "operation": {"enum": ["analyze", "realize", "generate", "paradigm", "availability", "lookup", "decode", "encode"]},
    "channel": {"enum": ["sentence", "morphology", "lexicon", "signal"]},
    "construction": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 128, "not": {"const": "all"}},
    "status": {"enum": ["implemented", "unsupported"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/evidence"},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"channel": {"const": "sentence"}}, "required": ["channel"]},
      "then": {"properties": {"operation": {"enum": ["analyze", "realize"]}}}
    },
    {
      "if": {"properties": {"channel": {"const": "morphology"}}, "required": ["channel"]},
      "then": {"properties": {"operation": {"enum": ["analyze", "generate", "paradigm", "availability"]}}}
    },
    {
      "if": {"properties": {"channel": {"const": "lexicon"}}, "required": ["channel"]},
      "then": {"properties": {"operation": {"const": "lookup"}}}
    },
    {
      "if": {"properties": {"channel": {"const": "signal"}}, "required": ["channel"]},
      "then": {"properties": {"operation": {"enum": ["decode", "encode"]}}}
    },
    {
      "if": {"properties": {"channel": {"const": "signal"}, "status": {"const": "implemented"}}, "required": ["channel", "status"]},
      "then": {"properties": {"operation": {"const": "decode"}, "construction": {"const": "written"}}}
    },
    {
      "if": {"properties": {"status": {"const": "implemented"}}, "required": ["status"]},
      "then": {"properties": {"evidence": {"contains": {"properties": {"kind": {"const": "manual-sentence"}}, "required": ["kind"]}}}}
    },
    {
      "if": {"properties": {"status": {"const": "unsupported"}}, "required": ["status"]},
      "then": {"properties": {"evidence": {"contains": {"properties": {"kind": {"const": "manual-refusal"}}, "required": ["kind"]}}}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["manual-sentence", "manual-refusal"]},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 128}
      },
      "additionalProperties": false
    }
  }
}
