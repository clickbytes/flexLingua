      "purpose": "Polish adjective-agreement witness: the red modifier belongs to the dog theme and adds a typed color edge without changing the event roles. Polish leaves definiteness open and English exposes both article choices.",
      "input": {
        "from": "pl",
        "to": "en",
        "text": "Dziewczynka widzi czerwonego psa."
      },
      "expected": {
        "status": "ok",
        "text": {"accepted": ["A girl sees a red dog."]},
        "meaning": {
          "type": "event",
          "concept": "event.visual_perception",
          "roleSet": ["agent", "theme"],
          "roles": {
            "agent": {
              "concept": "person.girl",
              "features": {"number": "singular", "definiteness": "unknown"},
              "modifiers": []
            },
            "theme": {
              "concept": "animal.dog",
              "features": {"number": "singular", "definiteness": "unknown"},
              "modifiers": [{"concept": "quality.red"}]
            }
          },
          "roleFeaturesExact": true,
          "modifiersExact": true,
          "features": {"tense": "present", "polarity": "positive", "aspect": "imperfective"},
          "featuresAllowExtra": false,
          "assert": {
            "#/roles/theme/modifiers/0/concept": "quality.red",
            "#/features/tense": "present",
            "#/features/polarity": "positive",
            "#/features/aspect": "imperfective"
          }
        },
        "diagnostics": {"required": [], "allowUnexpected": false},
        "alternatives": {"required": ["The girl sees the red dog."], "allowUnexpected": false},
        "informationLoss": {
          "required": [
            {"cause": "target-grammar-does-not-encode-aspect", "feature": "aspect", "path": "#/features/aspect", "status": "unavoidable"},
            {"cause": "source-definiteness-unspecified-target-default", "feature": "definiteness", "path": "#/roles/agent/features/definiteness", "status": "ambiguous"},
            {"cause": "source-definiteness-unspecified-target-default", "feature": "definiteness", "path": "#/roles/theme/features/definiteness", "status": "ambiguous"}
          ],
          "allowUnexpected": false
        },
        "graph": {
          "requiredEdges": [
            {"fromPath": "#/concept", "relation": "is_a", "toConcept": "event.perception"},
            {"fromPath": "#/roles/agent", "relation": "is_a", "toConcept": "person"},
            {"fromPath": "#/roles/theme", "relation": "is_a", "toConcept": "animal"},
            {"fromPath": "#/roles/theme/modifiers/0", "relation": "color", "toConcept": "color.red"}
          ],
          "forbiddenEdges": [
            {"fromPath": "#/roles/agent", "relation": "color", "toConcept": "color.red"}
          ],
          "allowUnexpected": true
        }
      },
      "review": {
        "status": "approved",
        "source": "Independent PL meaning and color scope recorded in #400 before CLI; delegated linguistic approval in #400 issuecomment-6250503432.",
        "author": "Codex agent, language review delegated by the project owner",
        "reviewedAt": "2026-10-18",
        "issue": "#400"
      },
      "requirements": {
        "coverageTargetId": "construction.event.visual_perception",
        "capability": "sentence pl.analyze(event.visual_perception) -> en.realize"
