        },
        "diagnostics": {"required": [], "allowUnexpected": false},
        "alternatives": {"required": [], "allowUnexpected": false},
        "informationLoss": {"required": [
          {"path": "#/proposition/roles/agent/features/definiteness", "feature": "definiteness", "cause": "target-grammar-does-not-mark-definiteness", "status": "unavoidable"},
