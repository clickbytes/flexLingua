{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flexlingua.dev/schemas/case.schema.json",
  "title": "flexLingua sentence-translation test case envelope",
  "description": "One envelope file under tests/cases/<from>-<to>/ holds an array of translation cases. Every case is machine-validated; only human-approved cases may enter the required gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" },
      "minItems": 1,
      "maxItems": 12
    }
  },
  "$defs": {
    "direction": {
      "type": "string",
      "enum": ["en-pl", "pl-en", "en-fi", "fi-en", "tr-en", "it-en", "en-it", "en-ar", "ar-en"]
    },
    "tagValue": { "type": ["string", "null"], "maxLength": 40 },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tense", "aspect", "polarity", "person", "number", "reference", "quantity"],
      "properties": {
        "tense": { "$ref": "#/$defs/tagValue" },
        "aspect": { "$ref": "#/$defs/tagValue" },
        "polarity": { "$ref": "#/$defs/tagValue" },
        "person": { "$ref": "#/$defs/tagValue" },
        "number": { "$ref": "#/$defs/tagValue" },
        "reference": { "$ref": "#/$defs/tagValue" },
        "quantity": { "$ref": "#/$defs/tagValue" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "text"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z]{2,8}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z]{2,8}$"
        },
        "text": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "includeSegments": { "type": "boolean" },
        "previewId": {
          "type": "string",
          "pattern": "^i[1-9][0-9]*\\.r[1-9][0-9]*$",
          "maxLength": 32
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "topics": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "senses": {
              "type": "object",
              "maxProperties": 8,
              "propertyNames": {
                "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "bindings": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "referentId"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^#(?:/(?:proposition|operand))*/roles/[a-z][a-zA-Z0-9_]{0,63}$"
                  },
                  "referentId": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                  }
                }
              }
            },
            "facts": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "referentId",
                  "feature",
                  "value",
                  "source"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "referentId": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "feature": {
                    "enum": [
                      "number",
                      "concept"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "request",
                          "session"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "turnId": {
                        "type": "string",
                        "pattern": "^t[1-9][0-9]*$"
                      },
                      "recordedAt": {
                        "type": "string",
                        "maxLength": 40
                      },
                      "language": {
                        "type": "string",
                        "maxLength": 8
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 4096
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxReadings": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            }
          }
        }
      }
    },
    "pointer": { "type": "string", "pattern": "^#(?:\\/(?:~[01]|[^~/])+)+$" },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "end": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "surfacePolicy": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "absent" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "variants", "allowUnexpected"],
          "properties": {
            "state": { "const": "present" },
            "allowUnexpected": { "type": "boolean" },
            "variants": {
              "type": "array", "minItems": 1, "maxItems": 8,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "construction", "slots"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
                  "construction": { "type": "string", "pattern": "^(?:question\\.yes-no|[a-z][a-z0-9_]+\\.[a-z][a-z0-9_]+)$" },
                  "slots": {
                    "type": "array", "minItems": 1, "maxItems": 16,
                    "items": {
                      "type": "object", "additionalProperties": false,
                      "required": ["name", "path", "text", "span"],
                      "properties": {
                        "name": { "type": "string", "pattern": "^(?:@[a-z]+|[a-z][a-zA-Z0-9_]*)$" },
                        "path": { "$ref": "#/$defs/pointer" },
                        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
                        "span": { "$ref": "#/$defs/span" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schemaVersion",
        "level",
        "mode",
        "direction",
        "family",
        "construction",
        "tier",
        "priority",
        "tags",
        "purpose",
        "input",
        "expected",
        "review",
        "requirements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A1-[A-Z]{2}-[A-Z]{2}-[A-Z]+-[0-9]{4}$",
          "minLength": 10,
          "maxLength": 64
        },
        "schemaVersion": {
          "const": "1.0"
        },
        "level": {
          "enum": [
            "A1",
            "pilot"
          ]
        },
        "mode": {
          "const": "single-sentence"
        },
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "construction": {
          "type": "string",
          "pattern": "^(?:question\\.yes-no|[a-z][a-z0-9_]+\\.[a-z][a-z0-9_]+)$"
        },
        "tier": {
          "enum": [
            "required",
            "exploratory"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "cliSmoke": {
          "type": "boolean"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "purpose": {
          "type": "string",
          "minLength": 10,
          "maxLength": 600
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "surfaceReview": {
          "$ref": "#/$defs/review"
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        },
        "verifyEngine": {
          "type": "boolean"
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caseId",
            "rememberRole"
          ],
          "properties": {
            "caseId": {
              "type": "string",
              "pattern": "^A1-[A-Z]{2}-[A-Z]{2}-[A-Z]+-[0-9]{4}$"
            },
            "rememberRole": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "text",
        "meaning",
        "diagnostics",
        "alternatives",
        "informationLoss"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "unsupported",
            "invalid",
            "ambiguous",
            "resource_limit"
          ]
        },
        "text": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accepted"
              ],
              "properties": {
                "accepted": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "minItems": 1,
                  "maxItems": 20
                }
              }
            }
          ]
        },
        "meaning": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/meaning"
            }
          ]
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnosticPolicy"
        },
        "alternatives": {
          "$ref": "#/$defs/alternativesPolicy"
        },
        "informationLoss": {
          "$ref": "#/$defs/informationLossPolicy"
        },
        "segments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "allowUnexpected"],
          "properties": {
            "required": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["meaningPath", "text", "targetSpan", "source"],
                "properties": {
                  "meaningPath": { "$ref": "#/$defs/pointer" },
                  "text": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "targetSpan": { "$ref": "#/$defs/span" },
                  "source": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["status", "span"],
                        "properties": {
                          "status": { "const": "aligned" },
                          "span": { "$ref": "#/$defs/span" }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["status", "reason"],
                        "properties": {
                          "status": { "const": "unavailable" },
                          "reason": { "type": "string", "minLength": 1, "maxLength": 128 }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "previewText": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            },
            "allowUnexpected": { "type": "boolean" }
          }
        },
        "surface": { "$ref": "#/$defs/surfacePolicy" },
        "graph": {
          "$ref": "#/$defs/graphPolicy"
        },
        "uncertainties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "allowUnexpected"
          ],
          "properties": {
            "required": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "path",
                  "options",
                  "reason"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "semantic_ambiguity",
                      "missing_information",
                      "equivalent_expression",
                      "additional_assumption",
                      "unsupported",
                      "search_limit",
                      "context_conflict"
                    ]
                  },
                  "path": {
                    "anyOf": [
                      {
                        "const": "#"
                      },
                      {
                        "$ref": "#/$defs/pointer"
                      }
                    ]
                  },
                  "options": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            },
            "allowUnexpected": {
              "type": "boolean"
            }
          }
        },
        "interpretations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "allowUnexpected",
            "preview",
            "tied"
          ],
          "properties": {
            "required": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "meaning",
                  "status",
                  "texts",
                  "ruleIds"
                ],
                "properties": {
                  "meaning": {
                    "$ref": "#/$defs/meaning"
                  },
                  "status": {
                    "enum": [
                      "ok",
                      "unsupported",
                      "resource_limit"
                    ]
                  },
                  "texts": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "assumptions": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 64
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  },
                  "ruleIds": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "diagnosticCodes": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "realizations": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["text", "kind", "assumptions"],
                      "properties": {
                        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
                        "kind": { "enum": ["equivalent_expression", "additional_assumption"] },
                        "assumptions": {
                          "type": "array",
                          "maxItems": 16,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["path", "feature"],
                            "properties": {
                              "path": { "$ref": "#/$defs/pointer" },
                              "feature": { "type": "string", "minLength": 1, "maxLength": 64 }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "allowUnexpected": {
              "type": "boolean"
            },
            "preview": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "accepted"
                  ],
                  "properties": {
                    "accepted": {
                      "type": "array",
                      "maxItems": 32,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "minItems": 1
                    }
                  }
                }
              ]
            },
            "tied": {
              "type": "boolean"
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bindings",
            "appliedFactIds",
            "ignoredFactIds",
            "conflictFactIds"
          ],
          "properties": {
            "bindings": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "referentId",
                  "status"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^#(?:/(?:proposition|operand))*/roles/[a-z][a-zA-Z0-9_]{0,63}$"
                  },
                  "referentId": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "status": {
                    "enum": [
                      "confirmed",
                      "unconfirmed"
                    ]
                  }
                }
              }
            },
            "appliedFactIds": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "ignoredFactIds": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "conflictFactIds": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "sessionSources": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "factId",
                  "sourceId",
                  "turnId",
                  "kind"
                ],
                "properties": {
                  "factId": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "sourceId": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "turnId": {
                    "type": "string",
                    "pattern": "^t[1-9][0-9]*$"
                  },
                  "kind": {
                    "const": "session"
                  }
                }
              }
            }
          }
        }
      }
    },
    "graphPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredEdges", "forbiddenEdges", "allowUnexpected"],
      "properties": {
        "requiredEdges": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/graphEdgeAssertion" }
        },
        "forbiddenEdges": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/graphEdgeAssertion" }
        },
        "unresolved": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "allowUnexpected"],
          "properties": {
            "required": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/graphUnresolvedAssertion" }
            },
            "allowUnexpected": { "type": "boolean" }
          }
        },
        "allowUnexpected": { "type": "boolean" }
      },
      "anyOf": [
        { "properties": { "requiredEdges": { "type": "array", "minItems": 1 } } },
        { "properties": { "forbiddenEdges": { "type": "array", "minItems": 1 } } },
        { "properties": { "unresolved": { "type": "object", "properties": { "required": { "type": "array", "minItems": 1 } } } } }
      ]
    },
    "graphUnresolvedAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "$ref": "#/$defs/pointer" },
        "reason": {
          "enum": ["NEGATED_CONTENT_NOT_PROJECTED", "QUESTION_CONTENT_NOT_ASSERTED",
            "HYPOTHETICAL_CONTENT_NOT_ASSERTED", "EMBEDDED_CONTENT_NOT_ASSERTED",
            "UNASSERTED_CONTENT_NOT_PROJECTED", "PREDICATE_SCOPE_UNSUPPORTED",
            "NESTED_MODIFIER_SCOPE_UNSUPPORTED", "REFERENT_WITHOUT_CONCEPT"]
        },
        "conceptId": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
        "operators": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["type", "questionType"], "properties": { "type": { "const": "question" }, "questionType": { "type": "string" } } },
              { "type": "object", "additionalProperties": false, "required": ["type", "operator"], "properties": { "type": { "enum": ["scope", "modality"] }, "operator": { "type": "string" } } },
              { "type": "object", "additionalProperties": false, "required": ["type", "kind"], "properties": { "type": { "const": "conditional" }, "kind": { "type": "string" } } },
              { "type": "object", "additionalProperties": false, "required": ["type", "concept"], "properties": { "type": { "const": "complement" }, "concept": { "type": "string" } } },
              { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "polarity" }, "value": { "const": "negative" } } }
            ]
          }
        }
      }
    },
    "graphEdgeAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromPath", "relation", "toConcept"],
      "properties": {
        "fromPath": { "$ref": "#/$defs/pointer" },
        "relation": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "toConcept": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$", "maxLength": 120 }
      }
    },
    "diagnosticPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "allowUnexpected"],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": { "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" } }
          }
        },
        "allowUnexpected": { "type": "boolean" }
      }
    },
    "alternativesPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "allowUnexpected"],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1, "maxLength": 200 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["meaning"],
                "properties": { "meaning": { "$ref": "#/$defs/meaning" } }
              }
            ]
          }
        },
        "allowUnexpected": { "type": "boolean" }
      }
    },
    "informationLossPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "allowUnexpected"],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/informationLossItem" }
        },
        "allowUnexpected": { "type": "boolean" }
      }
    },
    "informationLossItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "status"],
      "properties": {
        "cause": { "type": "string", "maxLength": 120 },
        "feature": { "type": "string", "minLength": 1, "maxLength": 64 },
        "path": { "$ref": "#/$defs/pointer" },
        "status": { "enum": ["unavoidable", "ambiguous", "intentional"] }
      }
    },
    "meaning": {
      "oneOf": [
        { "$ref": "#/$defs/clauseMeaning" },
        { "$ref": "#/$defs/questionMeaning" }
      ]
    },
    "clauseMeaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "roleSet", "roles", "features", "assert"],
      "properties": {
        "type": {
          "enum": ["event", "state", "discourse", "dialogue_act", "comparison", "coordination", "scope", "complement", "modality", "conditional"]
        },
        "concept": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "roleSet": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" }
        },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/participant" }
        },
        "roleFeaturesExact": { "type": "boolean" },
        "modifiersExact": { "type": "boolean" },
        "features": {
          "type": "object",
          "maxProperties": 10,
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
          "additionalProperties": { "type": "string" }
        },
        "featuresAllowExtra": { "type": "boolean" },
        "timeReference": {
          "enum": ["today", "tomorrow", "yesterday"]
        },
        "clockTime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hour", "minute"],
          "properties": {
            "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
            "minute": { "type": "integer", "minimum": 0, "maximum": 59 }
          }
        },
        "calendarDate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["year", "month", "day"],
          "properties": {
            "year": { "type": "integer", "minimum": 1, "maximum": 9999 },
            "month": { "type": "integer", "minimum": 1, "maximum": 12 },
            "day": { "type": "integer", "minimum": 1, "maximum": 31 }
          }
        },
        "assert": {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": { "$ref": "#/$defs/pointer" },
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        }
      }
    },
    "questionMeaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "questionType", "proposition", "assert"],
      "properties": {
        "type": { "const": "question" },
        "questionType": { "const": "yes_no" },
        "proposition": {
          "allOf": [
            { "$ref": "#/$defs/clauseMeaning" },
            { "properties": { "type": { "const": "event" } }, "required": ["type"] }
          ]
        },
        "assert": {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": { "$ref": "#/$defs/pointer" },
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        }
      }
    },
    "modifierDepth1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept"],
      "properties": {
        "concept": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
        "modifiers": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/modifierDepth2" }
        }
      }
    },
    "modifierDepth2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept"],
      "properties": {
        "concept": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
        "modifiers": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/modifierDepth3" }
        }
      }
    },
    "modifierDepth3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept"],
      "properties": {
        "concept": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "concept"
          ]
        },
        {
          "required": [
            "target"
          ]
        }
      ],
      "properties": {
        "concept": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "features": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "modifiers": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/modifierDepth1" }
        },
        "quantity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "exact"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "anchor"
              ],
              "properties": {
                "kind": {
                  "const": "deictic"
                },
                "anchor": {
                  "enum": [
                    "speaker",
                    "addressee",
                    "demonstrative"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "resolution"
              ],
              "properties": {
                "kind": {
                  "const": "anaphoric"
                },
                "resolution": {
                  "const": "unresolved"
                }
              }
            }
          ]
        },
        "agreement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "person",
            "number"
          ],
          "properties": {
            "person": {
              "enum": [
                "first",
                "second",
                "third"
              ]
            },
            "number": {
              "enum": [
                "singular",
                "plural"
              ]
            },
            "gender": {
              "enum": [
                "feminine",
                "masculine"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "target"
            ]
          },
          "then": {
            "required": [
              "agreement"
            ]
          }
        },
        {
          "if": {
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "anaphoric"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "agreement": {
                "type": "object",
                "required": [
                  "gender"
                ],
                "properties": {
                  "person": {
                    "const": "third"
                  },
                  "number": {
                    "const": "singular"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "agreement": {
                "type": "object",
                "not": {
                  "required": [
                    "gender"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "author", "reviewedAt", "issue"],
      "properties": {
        "status": { "enum": ["proposed", "approved"] },
        "source": { "type": ["string", "null"], "maxLength": 400 },
        "author": { "type": "string", "minLength": 3, "maxLength": 120 },
        "reviewedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "issue": { "type": "string", "pattern": "^#[0-9]{1,6}$" }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageTargetId", "capability"],
      "properties": {
        "coverageTargetId": {
          "type": "string",
          "pattern": "^(?:(?:concept|construction)\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*|construction\\.question\\.yes-no)$",
          "maxLength": 120
        },
        "capability": { "type": "string", "minLength": 3, "maxLength": 200 }
      }
    }
  }
}
