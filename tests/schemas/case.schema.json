{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flexlingua.dev/schemas/case.schema.json",
  "title": "flexLingua sentence-translation test case envelope",
  "description": "One envelope file under tests/cases/<from>-<to>/ holds an array of translation cases. Every case is machine-validated; only human-approved cases may enter the required gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" },
      "minItems": 1,
      "maxItems": 12
    }
  },
  "$defs": {
    "direction": {
      "type": "string",
      "enum": ["en-pl", "pl-en", "en-fi", "fi-en", "tr-en", "it-en", "en-it", "en-ar", "ar-en"]
    },
    "tagValue": { "type": ["string", "null"], "maxLength": 40 },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tense", "aspect", "polarity", "person", "number", "reference", "quantity"],
      "properties": {
        "tense": { "$ref": "#/$defs/tagValue" },
        "aspect": { "$ref": "#/$defs/tagValue" },
        "polarity": { "$ref": "#/$defs/tagValue" },
        "person": { "$ref": "#/$defs/tagValue" },
        "number": { "$ref": "#/$defs/tagValue" },
        "reference": { "$ref": "#/$defs/tagValue" },
        "quantity": { "$ref": "#/$defs/tagValue" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "text"],
      "properties": {
        "from": { "type": "string", "pattern": "^[a-z]{2,8}$" },
        "to": { "type": "string", "pattern": "^[a-z]{2,8}$" },
        "text": { "type": "string", "minLength": 3, "maxLength": 200 }
      }
    },
    "pointer": { "type": "string", "pattern": "^#(?:\\/(?:~[01]|[^~/])+)+$" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "level", "mode", "direction", "family", "construction", "tier", "priority", "tags", "purpose", "input", "expected", "review", "requirements"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A1-[A-Z]{2}-[A-Z]{2}-[A-Z]+-[0-9]{4}$",
          "minLength": 10,
          "maxLength": 64
        },
        "schemaVersion": { "const": "1.0" },
        "level": { "enum": ["A1", "pilot"] },
        "mode": { "const": "single-sentence" },
        "direction": { "$ref": "#/$defs/direction" },
        "family": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "construction": { "type": "string", "pattern": "^(?:question\\.yes-no|[a-z][a-z0-9_]+\\.[a-z][a-z0-9_]+)$" },
        "tier": { "enum": ["required", "exploratory"] },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "cliSmoke": { "type": "boolean" },
        "tags": { "$ref": "#/$defs/tags" },
        "purpose": { "type": "string", "minLength": 10, "maxLength": 600 },
        "input": { "$ref": "#/$defs/input" },
        "expected": { "$ref": "#/$defs/expected" },
        "review": { "$ref": "#/$defs/review" },
        "requirements": { "$ref": "#/$defs/requirements" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "text", "meaning", "diagnostics", "alternatives", "informationLoss"],
      "properties": {
        "status": { "enum": ["ok", "unsupported", "invalid", "ambiguous", "resource_limit"] },
        "text": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["accepted"],
              "properties": {
                "accepted": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "minItems": 1,
                  "maxItems": 20
                }
              }
            }
          ]
        },
        "meaning": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/meaning" } ] },
        "diagnostics": { "$ref": "#/$defs/diagnosticPolicy" },
        "alternatives": { "$ref": "#/$defs/alternativesPolicy" },
        "informationLoss": { "$ref": "#/$defs/informationLossPolicy" },
        "graph": { "$ref": "#/$defs/graphPolicy" }
      }
    },
    "graphPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredEdges", "forbiddenEdges", "allowUnexpected"],
      "properties": {
        "requiredEdges": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/graphEdgeAssertion" }
        },
        "forbiddenEdges": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/graphEdgeAssertion" }
        },
        "allowUnexpected": { "type": "boolean" }
      },
      "anyOf": [
        { "properties": { "requiredEdges": { "type": "array", "minItems": 1 } } },
        { "properties": { "forbiddenEdges": { "type": "array", "minItems": 1 } } }
      ]
    },
    "graphEdgeAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromPath", "relation", "toConcept"],
      "properties": {
        "fromPath": { "$ref": "#/$defs/pointer" },
        "relation": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "toConcept": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$", "maxLength": 120 }
      }
    },
    "diagnosticPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "allowUnexpected"],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": { "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" } }
          }
        },
        "allowUnexpected": { "type": "boolean" }
      }
    },
    "alternativesPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "allowUnexpected"],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1, "maxLength": 200 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["meaning"],
                "properties": { "meaning": { "$ref": "#/$defs/meaning" } }
              }
            ]
          }
        },
        "allowUnexpected": { "type": "boolean" }
      }
    },
    "informationLossPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "allowUnexpected"],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/informationLossItem" }
        },
        "allowUnexpected": { "type": "boolean" }
      }
    },
    "informationLossItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "status"],
      "properties": {
        "cause": { "type": "string", "maxLength": 120 },
        "feature": { "type": "string", "minLength": 1, "maxLength": 64 },
        "path": { "$ref": "#/$defs/pointer" },
        "status": { "enum": ["unavoidable", "ambiguous", "intentional"] }
      }
    },
    "meaning": {
      "oneOf": [
        { "$ref": "#/$defs/clauseMeaning" },
        { "$ref": "#/$defs/questionMeaning" }
      ]
    },
    "clauseMeaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "roleSet", "roles", "features", "assert"],
      "properties": {
        "type": {
          "enum": ["event", "state", "discourse", "dialogue_act", "comparison", "coordination", "scope", "complement", "modality", "conditional"]
        },
        "concept": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "roleSet": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" }
        },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/participant" }
        },
        "roleFeaturesExact": { "type": "boolean" },
        "modifiersExact": { "type": "boolean" },
        "features": {
          "type": "object",
          "maxProperties": 10,
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
          "additionalProperties": { "type": "string" }
        },
        "featuresAllowExtra": { "type": "boolean" },
        "assert": {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": { "$ref": "#/$defs/pointer" },
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        }
      }
    },
    "questionMeaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "questionType", "proposition", "assert"],
      "properties": {
        "type": { "const": "question" },
        "questionType": { "const": "yes_no" },
        "proposition": {
          "allOf": [
            { "$ref": "#/$defs/clauseMeaning" },
            { "properties": { "type": { "const": "event" } }, "required": ["type"] }
          ]
        },
        "assert": {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": { "$ref": "#/$defs/pointer" },
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["concept"] },
        { "required": ["target"] }
      ],
      "properties": {
        "concept": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
        "features": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
          "additionalProperties": { "type": "string" }
        },
        "modifiers": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["concept"],
            "properties": { "concept": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" } }
          }
        },
        "quantity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "exact" },
            "value": { "type": "integer", "minimum": 0, "maximum": 20 }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "anchor"],
          "properties": {
            "kind": { "const": "deictic" },
            "anchor": { "enum": ["speaker", "addressee", "demonstrative"] }
          }
        },
        "agreement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["person", "number"],
          "properties": {
            "person": { "enum": ["first", "second", "third"] },
            "number": { "enum": ["singular", "plural"] }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "author", "reviewedAt", "issue"],
      "properties": {
        "status": { "enum": ["proposed", "approved"] },
        "source": { "type": ["string", "null"], "maxLength": 400 },
        "author": { "type": "string", "minLength": 3, "maxLength": 120 },
        "reviewedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "issue": { "type": "string", "pattern": "^#[0-9]{1,6}$" }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageTargetId", "capability"],
      "properties": {
        "coverageTargetId": {
          "type": "string",
          "pattern": "^(?:(?:concept|construction)\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*|construction\\.question\\.yes-no)$",
          "maxLength": 120
        },
        "capability": { "type": "string", "minLength": 3, "maxLength": 200 }
      }
    }
  }
}
