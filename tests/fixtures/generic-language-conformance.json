{
  "schemaVersion": 1,
  "license": "project-authored",
  "origin": "Hand-authored bounded language package conformance examples. These cases are implementation checks, not CEFR or natural-language coverage evidence.",
  "cases": [
    {
      "id": "GLC-EN-PL-01",
      "capability": "end_to_end",
      "operation": "translate",
      "from": "en",
      "to": "pl",
      "input": "This is a simple book.",
      "expected": "To jest prosta książka.",
      "expectedCore": {
        "version": "1.31",
        "type": "state",
        "kind": "classification",
        "roles": {
          "subject": {"referent": {"kind": "deictic", "anchor": "demonstrative"}, "agreement": {"person": "third", "number": "singular"}},
          "category": {"concept": "object.book", "features": {"definiteness": "unknown", "number": "singular"}, "modifiers": [{"concept": "quality.simple"}]}
        },
        "features": {"tense": "present", "polarity": "positive"}
      },
      "source": "Project-authored A1-ENPL-01 static CORE and target sentence, retained as a controlled package regression."
    },
    {
      "id": "GLC-PL-EN-01",
      "capability": "end_to_end",
      "operation": "translate",
      "from": "pl",
      "to": "en",
      "input": "To jest prosta książka.",
      "expected": "This is a simple book.",
      "source": "Project-authored reverse sentence from the controlled EN/PL basics gold."
    },
    {
      "id": "GLC-EN-PL-02",
      "capability": "end_to_end",
      "operation": "translate",
      "from": "en",
      "to": "pl",
      "input": "The girl sees the dog.",
      "expected": "Dziewczynka widzi psa.",
      "source": "Project-authored discourse regression sentence."
    },
    {
      "id": "GLC-TR-EN-01",
      "capability": "end_to_end",
      "operation": "translate",
      "from": "tr",
      "to": "en",
      "input": "Kız köpeği gördü.",
      "expected": "A girl saw the dog.",
      "source": "Project-authored Turkish package gold in tests/tr-audit.test.js."
    },
    {
      "id": "GLC-IT-EN-01",
      "capability": "end_to_end",
      "operation": "translate",
      "from": "it",
      "to": "en",
      "input": "La ragazza vede il cane.",
      "expected": "The girl sees the dog.",
      "source": "Project-authored Italian transit gold in tests/it-gold.test.js."
    },
    {
      "id": "GLC-IT-SYNTAX-01",
      "capability": "syntax",
      "operation": "roundtrip",
      "language": "it",
      "input": "Le ragazze non vedono i cani.",
      "expected": "Le ragazze non vedono i cani.",
      "source": "Project-authored Italian plural and negation parser/realizer case from tests/it-gold.test.js."
    },
    {
      "id": "GLC-TR-SYNTAX-01",
      "capability": "syntax",
      "operation": "roundtrip",
      "language": "tr",
      "input": "Kız köpeği gördü.",
      "expected": "Kız köpeği gördü.",
      "source": "Project-authored Turkish parser/realizer transit case from tests/tr-audit.test.js."
    },
    {
      "id": "GLC-EN-MORPH-01",
      "capability": "morphology",
      "operation": "morphology",
      "language": "en",
      "lexemeId": "en.dog.1",
      "features": {"number": "plural"},
      "expectedForms": ["dogs"],
      "source": "Project-authored English noun paradigm cell."
    },
    {
      "id": "GLC-PL-MORPH-01",
      "capability": "morphology",
      "operation": "morphology",
      "language": "pl",
      "lexemeId": "pl.kot.1",
      "features": {"number": "plural", "case": "nom"},
      "expectedForms": ["koty"],
      "source": "Project-authored Polish noun paradigm cell from tests/morphology.test.js."
    },
    {
      "id": "GLC-AR-MORPH-01",
      "capability": "morphology",
      "operation": "morphology",
      "language": "ar",
      "lexemeId": "ar.kataba.1",
