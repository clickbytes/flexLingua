      "expectedForms": ["كَتَبَ"],
      "source": "Project-authored Arabic morphology-only paradigm cell from tests/morphology.test.js."
    },
    {
      "id": "GLC-EN-REFUSAL-01",
      "capability": "refusal",
      "operation": "translate",
      "from": "en",
      "to": "pl",
      "input": "I is reading a book.",
      "expectedRefusal": true,
      "expectedError": "INVALID_INPUT",
      "source": "Project-authored incorrect agreement refusal."
    },
    {
      "id": "GLC-EN-PL-LOSS-01",
      "capability": "information_loss",
      "operation": "translate",
      "from": "en",
      "to": "pl",
      "input": "The girl sees the dog. She sees the cat.",
      "expected": "Dziewczynka widzi psa. Dziewczynka widzi kota.",
      "expectedWarningIncludes": "target repeats the noun phrase",
      "source": "Project-authored anaphora case; its warning records that the target wording repeats a noun and loses the source pronoun distinction."
    },
    {
      "id": "GLC-CORE-01",
      "capability": "core_semantics",
      "operation": "core_validate",
      "expectedValid": true,
      "core": {
        "version": "1.31",
        "type": "state",
        "kind": "classification",
        "roles": {
          "subject": {"referent": {"kind": "deictic", "anchor": "demonstrative"}, "agreement": {"person": "third", "number": "singular"}},
          "category": {"concept": "object.book", "features": {"definiteness": "unknown", "number": "singular"}, "modifiers": [{"concept": "quality.simple"}]}
        },
        "features": {"tense": "present", "polarity": "positive"}
      },
      "source": "Project-authored static CORE validity case aligned with GLC-EN-PL-01."
    },
    {
      "id": "GLC-MANIFEST-REFUSAL-01",
      "capability": "refusal",
      "operation": "invalid_manifest",
      "language": "en",
      "mutation": ["version", "9.9"],
      "expectedError": "Invalid language package manifest",
      "source": "Project-authored mutation of a package manifest; malformed package versions must be rejected."
    }
  ]
