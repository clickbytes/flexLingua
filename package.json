    "compile:en": "node tools/compile-language.mjs en",
    "compile:ar": "node tools/compile-language.mjs ar",
    "test": "node tests/run.mjs --all",
    "test:matrix": "node tests/run.mjs --matrix",
    "test:cli": "node tests/run.mjs --cli"
  },
  "dependencies": {
    "terminal-kit": "3.1.4"
  },
  "devDependencies": {
    "ajv": "8.20.0"
