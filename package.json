{
  "name": "flexlingua",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "translate": "node tools/translate.mjs",
    "languages": "node tools/translate.mjs --languages",
