    "check:gold-multiword": "node --test tests/multiword-morphology-f3.test.js",
    "report:a1": "node tools/report-a1.mjs",
    "check:a1-gold": "node tools/report-a1.mjs --strict",
    "audit:a1-gaps": "node tools/a1-gap-audit.mjs",
    "check:gold-family": "node --test tests/family-actions-a1.test.js",
    "check:gold-father": "node --test tests/father-a1.test.js",
    "check:gold-movement": "node --test tests/movement-a1.test.js",
    "check:gold-actions": "node --test tests/daily-actions-a1.test.js tests/a1-crossbatch-composition.test.js",
    "check:gold-person": "node --test tests/a1-person-gold.test.js",
    "report:a1-evidence": "node tools/a1-evidence-ledger.mjs --catalog-only",
    "check:a1-evidence": "node tools/a1-evidence-ledger.mjs"
  }
