{
  "name": "flexlingua",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "node tools/serve.mjs",
    "check:lexicon": "node tools/check-lexicon.mjs",
    "check:morphology": "node tools/check-morphology.mjs",
    "check:data-provenance": "node tools/check-data-provenance.mjs",
    "check:core-gates": "node tools/check-core-gates.mjs",
    "setup:local-hooks": "node tools/install-local-hooks.mjs",
    "check:local:quick": "node tools/local-check.mjs quick",
    "check:local": "node tools/local-check.mjs full",
    "compile:pl": "node tools/compile-language.mjs pl",
    "compile:en": "node tools/compile-language.mjs en",
    "compile:ar": "node tools/compile-language.mjs ar",
    "check:release": "npm run check:lexicon && npm run check:morphology && npm run check:data-provenance && npm run check:gold && npm run check:a1-gold && npm run check:gold-family && npm run check:gold-father && npm run check:gold-movement && npm run check:gold-actions && npm run check:gold-person && npm run check:a1-evidence && npm run check:dialogue-gold && npm test && npm run check:coverage",
    "check:gold": "node tools/verify-gold.mjs",
    "coverage:a1": "node tools/coverage-a1.mjs",
